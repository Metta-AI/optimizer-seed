{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./tools/rotate_lessons.sh",
            "timeout": 15,
            "statusMessage": "Rotating tentative-lesson buffers"
          },
          {
            "type": "command",
            "command": "./tools/baseline_session_start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./tools/baseline_pretooluse_gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./tools/lessons_stop_nudge.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
