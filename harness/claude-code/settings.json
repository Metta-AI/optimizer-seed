{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/rotate_lessons.sh\"",
            "timeout": 15,
            "statusMessage": "Rotating tentative-lesson buffers"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/lessons_stop_nudge.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
