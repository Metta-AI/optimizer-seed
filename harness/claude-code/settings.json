{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/rotate_lessons.sh\"",
            "timeout": 15,
            "statusMessage": "Rotating tentative-lesson buffers"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/baseline_session_start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/baseline_pretooluse_gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/lessons_stop_nudge.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/experiments_stop_nudge.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
